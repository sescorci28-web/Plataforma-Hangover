{
  "expo": {
    "name": "App-Hangover",
    "slug": "App-Hangover",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apphangover",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.sescorci.AppHangover"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sescorci.AppHangover"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050212",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#050212",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-video",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f63b2538-5e66-4683-86d1-921e6f37caed"
      },
      "EXPO_PUBLIC_SUPABASE_URL": "https://ouibyflexyntquwptkhh.supabase.co",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_Q2nGAVHUY2In3SY6bF3-Xg_tg2JR5EZ"
    }
  }
}
